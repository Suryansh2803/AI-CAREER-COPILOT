# ══════════════════════════════════════════════════
# AI CAREER COPILOT — Environment Variables Template
# Copy this to .env and fill in your values
# ══════════════════════════════════════════════════

PORT=5000
NODE_ENV=development

MONGODB_URI=mongodb://127.0.0.1:27017/ai-career-copilot

JWT_SECRET=your-secret-key-here
JWT_EXPIRES_IN=7d

# AI Service (optional)
# OPENAI_API_KEY=sk-your-key-here
# AI_PROVIDER=openai

CLIENT_URL=http://localhost:5173
